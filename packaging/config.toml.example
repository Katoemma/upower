[server]
host = "127.0.0.1"
port = 8765

[notifications]
enabled = true
ac_connected = true
ac_disconnected = true
fully_charged = true
low_battery = true
critical_battery = true

# SMTP credentials live in `.env` (see `.env.example`), not here.
[email]
enabled = true
ac_connected = false
ac_disconnected = true
fully_charged = false
low_battery = true
critical_battery = true

# Firebase credentials live in `.env`; device tokens via CLI/API.
[push]
enabled = true
ac_connected = false
ac_disconnected = true
fully_charged = false
low_battery = true
critical_battery = true

[battery]
low_threshold = 20
critical_threshold = 10

[monitoring]
memory_interval_ms = 1000
cpu_interval_ms = 1000
storage_interval_ms = 5000
processes_interval_ms = 2000
process_limit = 20
