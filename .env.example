# Brevo SMTP (https://app.brevo.com/settings/keys/smtp)
# Copy to `.env` and fill in your SMTP key. Never commit `.env`.

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login-email@example.com
SMTP_PASSWORD=your-brevo-smtp-key
SMTP_FROM="Power Monitor <your-verified-sender@example.com>"
SMTP_TO=nativesenior@gmail.com
