# Brevo SMTP — https://app.brevo.com/settings/keys/smtp
# From MUST be verified under Brevo → Senders (not *@smtp-brevo.com)

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-login@smtp-brevo.com
SMTP_PASSWORD=your-brevo-smtp-key

# Required: verified sender email in Brevo
SMTP_FROM_ADDRESS=your-verified-sender@example.com
SMTP_FROM_NAME=Power Monitor
SMTP_TO=nativesenior@gmail.com

# Laravel-style aliases also work:
# MAIL_USERNAME=...
# MAIL_PASSWORD=...
# MAIL_FROM_ADDRESS=...
# MAIL_FROM_NAME=...
