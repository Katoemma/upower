# Brevo SMTP — https://app.brevo.com/settings/keys/smtp
# From MUST be verified under Brevo → Senders (not *@smtp-brevo.com)

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-login@smtp-brevo.com
SMTP_PASSWORD=your-brevo-smtp-key

# Required: verified sender email in Brevo
SMTP_FROM_ADDRESS=your-verified-sender@example.com
SMTP_FROM_NAME=Power Monitor
SMTP_TO=katoemmy001@gmail.com

# Laravel-style aliases also work:
# MAIL_USERNAME=...
# MAIL_PASSWORD=...
# MAIL_FROM_ADDRESS=...
# MAIL_FROM_NAME=...

# --- Firebase Cloud Messaging (pick ONE auth method) ---
# Preferred: service account JSON (FCM HTTP v1)
# FIREBASE_CREDENTIALS=/absolute/path/to/firebase-service-account.json
# FIREBASE_PROJECT_ID=your-project-id

# Or legacy server key (simpler for quick tests):
# FCM_SERVER_KEY=AAAA...your-cloud-messaging-server-key

# Optional override for where device tokens are stored:
# FCM_TOKENS_FILE=/home/you/.local/share/power-monitor/fcm_tokens.txt
